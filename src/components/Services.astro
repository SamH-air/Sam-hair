---
import { SERVICES } from "../data/services";

// SVG inline par icône pour éviter l'import JS de lucide côté serveur
const ICONS = {
  scissors: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 0 6.5 6.5M6 9l4.5 4.5M18 9a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm0 0-6.5 6.5m0 0-1 1a3.5 3.5 0 1 1-4.95-4.95l1-1m5.95 3.95 1 1a3.5 3.5 0 0 0 4.95-4.95l-1-1" /></svg>`,
  sparkles: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>`,
  wind: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.25 3.75a6 6 0 0 1 11.5 2.25c0 3.31-2.69 6-6 6H3M3 12h6.25a6 6 0 0 1 0 12H3m0-12V6.75" /></svg>`,
  heart: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>`
};
---

<section id="services" class="section-padding bg-graphite/30" aria-labelledby="services-heading">
  <div class="max-w-7xl mx-auto text-center mb-16">
    <h2 id="services-heading" class="text-3xl md:text-5xl mb-4">Nos Services à Domicile</h2>
    <div class="w-24 h-1 bg-golden-bronze mx-auto" aria-hidden="true"></div>
    <p class="mt-6 text-lavender-blush/70 max-w-2xl mx-auto text-lg italic">
      "Chaque cheveu a son histoire, nous écrivons avec vous le prochain chapitre."
    </p>
    <p class="mt-3 text-golden-bronze/80 text-sm tracking-widest uppercase">
      Déplacements autour de Stutzheim, Wasselonne &amp; alentours (67)
    </p>
  </div>

  <ul class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-4 gap-8 list-none p-0">
    {SERVICES.map((service) => (
      <li class="glass-card p-10 text-center flex flex-col items-center transition-transform duration-300 hover:-translate-y-2">
        <div class="w-20 h-20 rounded-full border border-golden-bronze/30 flex items-center justify-center text-golden-bronze mb-6 bg-coffee-bean" aria-hidden="true">
          <Fragment set:html={ICONS[service.icon]} />
        </div>
        <h3 class="text-xl font-display mb-4 text-lavender-blush">{service.title}</h3>
        <p class="text-lavender-blush/60 leading-relaxed font-light">{service.description}</p>
      </li>
    ))}
  </ul>
</section>
