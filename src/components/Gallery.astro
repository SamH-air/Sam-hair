---
import { GALLERY, FEATURED_GALLERY } from "../data/gallery";
---

<section id="galerie" class="section-padding bg-graphite/30" aria-labelledby="gallery-heading">
  <div class="max-w-7xl mx-auto text-center mb-16">
    <h2 id="gallery-heading" class="text-3xl md:text-5xl mb-4">Nos réalisations</h2>
    <div class="w-24 h-1 bg-golden-bronze mx-auto" aria-hidden="true"></div>
    <p class="mt-6 text-lavender-blush/60 text-sm italic">Réalisations de Samantha Huoy — à votre domicile</p>
  </div>

  <ul class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-5 list-none p-0">
    {FEATURED_GALLERY.map((img, index) => (
      <li class="relative overflow-hidden rounded-2xl group aspect-[4/5]">
        <a href={`/realisations/#${img.category}`} class="block w-full h-full">
          <img
            src={img.url}
            alt={img.alt}
            width={img.width}
            height={img.height}
            class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
            loading={index < 3 ? "eager" : "lazy"}
            decoding="async"
          />
          {img.beforeAfter && (
            <span aria-hidden="true" class="absolute top-3 left-3 bg-coffee-bean/80 text-golden-bronze text-[10px] tracking-[0.2em] uppercase px-2.5 py-1 rounded-full">
              Avant / Après
            </span>
          )}
          <div aria-hidden="true" class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-coffee-bean/90 via-coffee-bean/40 to-transparent px-4 md:px-5 py-4 translate-y-1 group-hover:translate-y-0 transition-transform duration-300">
            <p class="text-golden-bronze font-display text-base md:text-lg leading-tight">{img.title}</p>
            <p class="text-lavender-blush/70 text-xs mt-0.5 tracking-wide">{img.prestation}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <div class="max-w-7xl mx-auto text-center mt-12">
    <a href="/realisations/" class="btn-primary gap-3">
      Voir toutes les réalisations
      <span class="text-coffee-bean/80 text-sm font-normal">({GALLERY.length} photos)</span>
    </a>
  </div>
</section>
