---
import BaseLayout    from "../layouts/BaseLayout.astro";
import Header        from "../components/Header";
import Hero          from "../components/Hero.astro";
import Services      from "../components/Services.astro";
import Pricing       from "../components/Pricing.astro";
import Gallery       from "../components/Gallery.astro";
import ContactForm   from "../components/ContactForm";
import Footer        from "../components/Footer.astro";
---

<BaseLayout
  title="Coiffeuse à domicile Wasselonne & Stutzheim | S-MH'air"
  description="Samantha Huoy, coiffeuse à domicile depuis 15 ans autour de Stutzheim et Wasselonne (67) : coupes, balayages, coiffures de mariage. RDV au 06 37 73 71 42."
>
  <Header client:load />

  <main id="contenu" tabindex="-1">
    <Hero />
    <Services />
    <Pricing />
    <Gallery />
    <ContactForm client:visible />
  </main>

  <Footer />
</BaseLayout>
